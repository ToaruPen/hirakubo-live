{
  "name": "hirakubo-live",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "uv run python hirakubo_live_build.py",
    "lint": "pnpm lint:js && pnpm lint:py",
    "lint:js": "oxlint --deny-warnings",
    "lint:py": "uv run ruff check && uv run ruff format --check",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "1.63.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "wrangler": "4.139.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
