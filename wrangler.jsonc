{
  // The live wallpaper as a static site on Cloudflare: the Wallpaper Engine build is one
  // self-contained index.html, served as it is (no Worker code), on its own domain only
  "name": "hirakubo-live",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "./hirakubo_live" },
  "routes": [{ "pattern": "hirakubo.toarupen.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
